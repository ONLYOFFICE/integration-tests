# Copy to .env and adjust for your environment.
# The stack is spun up by global.setup before the tests and fully removed after the run.
# The host IP is detected automatically (via a hairpin check from the DS container) —
# works both locally and in CI.

ALFRESCO_USER=admin
ALFRESCO_PASSWORD=admin
# Version of the alfresco-content-repository-community and alfresco-share images
ALFRESCO_VERSION=26.1.0

# Version of the atlassian/confluence image
CONFLUENCE_VERSION=10.2.14

# The default license is fetched automatically from Atlassian's "timebomb" licenses page
# for testing DC products (tests/setup/confluence-license.ts) — usually no need to set it.
# CONFLUENCE_LICENSE_KEY=

# Document Server image spun up before the tests (port is always 80)
DOCUMENTSERVER_IMAGE=onlyoffice/documentserver:latest

# The JWT secret is generated on every run and passed to both Document Server and the plugin.

# --- Reuse already-running stands instead of spinning fresh ones up (speeds up local dev) ---
# Set any of the *_URL variables below to skip that stack's setup entirely (no docker compose up,
# no plugin install/config) and point tests straight at an already-running, already-configured
# stand. Leave commented out to always get a fresh disposable stack from global.setup.

# Existing Document Server — must have JWT_ENABLED with the matching secret below.
# DOCUMENTSERVER_URL=http://192.168.1.10/
# DOCUMENTSERVER_SECRET=

# Existing Alfresco with the ONLYOFFICE plugin already installed and pointed at the Document
# Server above.
# ALFRESCO_URL=http://192.168.1.10:8080

# Existing Confluence with the ONLYOFFICE plugin already installed and pointed at the Document
# Server above.
# CONFLUENCE_URL=http://192.168.1.10:8090
