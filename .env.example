# Copy to .env and adjust for your environment.
# Each test run targets a single system (npm run test:<system>); the stack is spun up by
# global.setup before the tests and fully removed after the run.
# The host IP shared by the browser and the containers is detected automatically: every
# candidate address (the machine's own interfaces, the docker host as seen from inside a
# container) is probed from both sides — works locally and in CI, including runners that
# execute the job itself inside a container.
# OIT_HOST_IP=192.168.1.10   # pin it when the automatic probe finds nothing

# Version of the alfresco-content-repository-community and alfresco-share images
ALFRESCO_VERSION=26.1.0

# Version of the atlassian/confluence image
CONFLUENCE_VERSION=10.2.14
# The default license is fetched automatically from Atlassian's "timebomb" licenses page
# for testing DC products (tests/setup/confluence-license.ts) — usually no need to set it.
# CONFLUENCE_LICENSE_KEY=

# Version of the atlassian/jira-software image
JIRA_VERSION=11.3.4
# The default license is fetched automatically from Atlassian's "timebomb" licenses page
# for testing DC products (tests/setup/jira-license.ts) — usually no need to set it.
# JIRA_LICENSE_KEY=

# Liferay Docker image tag — required, no default (tests/setup/liferay.ts).
# Use liferay/dxp:... for the paid distribution — it requires a license, either as a file at
# environments/liferay/artifacts/license.xml or via LIFERAY_LICENSE below.
# 7.2 works too: its headless REST modules are read-only, so account/role/permission setup falls
# back to the classic JSONWS API there (see tests/setup/liferay.ts and adapter-liferay).
LIFERAY_IMAGE=liferay/portal:7.4.3.132-ga132
# The DXP license XML itself — verbatim or base64-encoded — written to the artifacts file above
# on setup. Meant for CI, where the license is a secret and can't be a file in the repository
# (see the liferay_license secret in .github/workflows/e2e.yml); locally the file is simpler.
# LIFERAY_LICENSE=

# Document Server image spun up before the tests (port is always 80)
DOCUMENTSERVER_IMAGE=onlyoffice/documentserver:latest

# The JWT secret is generated on every run and passed to both Document Server and the plugin.
# Test account credentials (admin, and the second/read-only accounts each stand's tests use) are
# fixed in code (tests/setup/<system>.ts, tests/fixtures.ts) — not configurable via this file.

# --- Reuse an already-running stand instead of spinning a fresh one up (speeds up local dev) ---
# Set the *_URL variable for the system you're testing (and, if needed, DOCUMENTSERVER_URL) to
# skip that stack's setup entirely (no docker compose up, no plugin install/config) and point
# tests straight at an already-running, already-configured stand. Leave commented out to always
# get a fresh disposable stack from global.setup. The reused stand must use the same fixed test
# account credentials the tests expect (see tests/fixtures.ts).

# Existing Document Server — must have JWT_ENABLED with the matching secret below.
# DOCUMENTSERVER_URL=http://192.168.1.10/
# DOCUMENTSERVER_SECRET=

# Existing Alfresco with the ONLYOFFICE plugin already installed and pointed at the Document
# Server above.
# ALFRESCO_URL=http://192.168.1.10:8080

# Existing Confluence with the ONLYOFFICE plugin already installed and pointed at the Document
# Server above.
# CONFLUENCE_URL=http://192.168.1.10:8090

# Existing Jira with the ONLYOFFICE plugin already installed and pointed at the Document
# Server above.
# JIRA_URL=http://192.168.1.10:8080

# Existing Liferay with the ONLYOFFICE plugin already installed and pointed at the Document
# Server above.
# LIFERAY_URL=http://192.168.1.10:8080
