# Copy to .env and adjust for your environment.
# The stack is spun up by global.setup before the tests and fully removed after the run.
# The host IP is detected automatically (via a hairpin check from the DS container) —
# works both locally and in CI.

ALFRESCO_USER=admin
ALFRESCO_PASSWORD=admin
# Version of the alfresco-content-repository-community and alfresco-share images
ALFRESCO_VERSION=26.1.0

# Document Server image spun up before the tests
DOCUMENTSERVER_IMAGE=onlyoffice/documentserver:latest
DOCUMENTSERVER_PORT=80
DOCUMENTSERVER_CONTAINER=onlyoffice-ds-tests

# The JWT secret is generated on every run and passed to both Document Server and the plugin.
# ONLYOFFICE_JWT_SECRET=...  # a fixed secret instead of a generated one
# TEST_HOST_IP=192.168.56.1  # host IP manually, if auto-detection picked the wrong adapter
# STACK_MANAGED=false        # tests don't touch Docker; ALFRESCO_URL is then required
# ALFRESCO_URL=http://192.168.56.1:8080  # address of an already-running stack (only with STACK_MANAGED=false)
