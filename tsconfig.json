{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@core": ["packages/core/src/index.ts"],
      "@adapters/alfresco": ["packages/adapter-alfresco/src/index.ts"],
      "@adapters/confluence": ["packages/adapter-confluence/src/index.ts"],
      "@adapters/jira": ["packages/adapter-jira/src/index.ts"],
      "@adapters/liferay": ["packages/adapter-liferay/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
